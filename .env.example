# Скопируйте этот файл в .env и при необходимости отредактируйте значения.

# Адрес OpenAI-совместимого LLM-сервера (LM Studio или облачный провайдер).
LLM_BASE_URL=http://localhost:1234/v1

# Ключ доступа. Для LM Studio — любое непустое значение.
LLM_API_KEY=lm-studio

# Две модели под два типа задач (порт DZ_1):
# CHEAP_MODEL — классификация, валидатор, формирование аргументов тикета,
# типовая генерация при высоком скоре релевантности и risk=low.
CHEAP_MODEL=google/gemma-4--qat
# ADVANCED_MODEL — генерация при complexity=complex или низком скоре релевантности,
# перегенерация после провала валидации.
ADVANCED_MODEL=google/gemma-4-12b-qat

# Таймаут на запрос к LLM, секунд (one-shot на локальной модели может быть долгим).
LLM_REQUEST_TIMEOUT_SECONDS=120

# Идентификатор embedding-модели на том же сервере (для векторного поиска).
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b

# Размерность вектора эмбеддинга (должна совпадать с моделью и коллекцией Qdrant).
EMBEDDING_DIM=1024

# Адрес Qdrant-сервера (Docker-контейнер).
QDRANT_URL=http://localhost:6333

# Название коллекции в Qdrant (создаётся автоматически при первом запуске).
QDRANT_COLLECTION=dz7_case1

# Путь к базе знаний (FAQ-документы для поиска контекста), относительно корня проекта.
KB_FILE=context/kb.json

# Путь к файлу памяти Q&A (граф: узлы qa + рёбра к doc).
QA_MEMORY_FILE=memory/qa.json

# --- Тикет-сервис (инструмент create_ticket) ---

# Адрес мок-тиккет-системы (ticket_server.py, stdlib http.server).
TICKET_API_URL=http://127.0.0.1:8766

# Таймаут на запрос к тикет-сервису, секунд.
TICKET_TIMEOUT_SECONDS=5

# Жёсткий лимит LLM-вызовов на формирование аргументов create_ticket
# (защита от цикла «модель снова и снова возвращает невалидные аргументы»).
MAX_TOOL_STEPS=4

# --- Пороги и лимиты сценария ---

# Порог релевантности найденного контекста (косинусное сходство, 0..1).
# Ниже порога — вежливый отказ (ветка refuse), а не ответ без контекста.
RELEVANCE_THRESHOLD=0.3

# Порог совпадения с уже обработанным вопросом из памяти (0..2, keyword-скоринг).
# Повторный вопрос — ответ из памяти, без нового обращения к LLM.
# Не опускать: ниже 1.5 «похожие, но разные» вопросы дают ложные хиты.
MEMORY_HIT_THRESHOLD=1.5

# Сколько раз перегенерировать ответ, если проверка/валидация его отвергла
# (повтор узла generate). Формирование аргументов create_ticket ограничено
# отдельно: MAX_TOOL_STEPS.
MAX_VALIDATION_RETRIES=2

# Максимум состояний за один прогон сценария (защита от зацикливания).
# recursion_limit у LangGraph задаётся автоматически: MAX_STEPS + запас.
MAX_STEPS=15

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=ERROR

# --- Контрольный слой ---

# Предохранитель: максимум LLM-вызовов за один прогон. Превышение —
# эскалация с причиной budget_exceeded, а не падение.
MAX_LLM_CALLS_PER_RUN=6

# Сколько раз повторять сетевой вызов LLM (только APIConnectionError /
# APITimeoutError, backoff 0.5с/1.5с). 4xx не ретраются.
LLM_MAX_RETRIES=2

# Лимит длины ответа для детерминированной проверки check_answer.
MAX_ANSWER_CHARS=2000

# Файл лога выполнения (JSONL, одна строка на прогон). Часть сдачи.
RUNS_LOG_FILE=logs/runs.jsonl

# Максимум записей в логе: при переполнении файл ротируется в logs/runs.jsonl.1
# (хранится один архив). 0 — ротация выключена.
RUNS_LOG_MAX_RECORDS=1000

# Тариф за 1 000 000 токенов в рублях — для метрики cost_rub (оценочный
# тариф облачного эквивалента локальной модели). Входные (prompt) и
# выходные (completion) токены тарифицируются отдельно.
LLM_COST_INPUT_PER_1M_RUB=15
LLM_COST_OUTPUT_PER_1M_RUB=60

# Порог доли эскалаций (0..1): выше — алерт в конце --demo и в --report
# (по умолчанию 0.2 — если более 20% прогонов завершено эскалацией).
ERROR_ALERT_THRESHOLD=0.2
